# ==============================================================================
# RaptorERP — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your local or production
# environment. Never commit real credentials, production secrets, or API keys
# to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Information & Environment
# ------------------------------------------------------------------------------
APP_NAME="RaptorERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Primary Database Connection (MySQL / MariaDB recommended)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=raptore_db
DB_USERNAME=root
DB_PASSWORD=
# DB_SOCKET=
# DB_FOREIGN_KEYS=true

# ------------------------------------------------------------------------------
# Session, Cache, Queue & Filesystem Drivers
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------------
# Redis & Memcached (Optional)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# ------------------------------------------------------------------------------
# Mail & SMTP Configuration
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@raptorerp.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Google Drive Automated Backup & Disaster Recovery System
# ------------------------------------------------------------------------------
# Dedicated installation identifier used to isolate and identify backup runs
BACKUP_INSTALLATION_ID=raptorerp-prod

# Private staging directory outside the public web root for unencrypted dumps
BACKUP_TEMP_DIR=

# Dedicated 256-bit AES-GCM encryption key (32 bytes raw or 64-character hex string)
BACKUP_ENCRYPTION_KEY=
BACKUP_ACTIVE_KEY_VERSION=v1

# Custom path to database binaries if not available in system PATH (e.g. C:\xampp\mysql\bin\mysqldump.exe)
BACKUP_MYSQLDUMP_BINARY=
BACKUP_MYSQL_BINARY=

# Automated schedule & retention defaults (Asia/Kolkata 02:00 AM IST)
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_DEFAULT_TIME="02:00"
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_WEEKLY=12
BACKUP_RETENTION_MONTHLY=12

# Upload chunk size for Google Drive resumable streaming (in bytes, multiple of 256 KiB)
BACKUP_CHUNK_SIZE=2097152

# Google Drive OAuth 2.0 Credentials
GOOGLE_DRIVE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_DRIVE_CLIENT_SECRET="your-client-secret"
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:5173/backup-restore"
GOOGLE_DRIVE_PICKER_API_KEY=

# ------------------------------------------------------------------------------
# AI Engine & LLM Integrations
# ------------------------------------------------------------------------------
# Google Gemini API (Recommended primary AI provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VERIFY_SSL=true

# OpenAI API (Fallback / Alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PROJECT_ID=

# ------------------------------------------------------------------------------
# Multi-Channel Notifications & Messaging
# ------------------------------------------------------------------------------
# Twilio SMS & Official WhatsApp Business API
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_URL=

# WhatsApp Web.js Microservice (Local worker bridge)
WHATSAPP_WEB_JS_ENABLED=true
WHATSAPP_SERVICE_URL="http://127.0.0.1:3010"
WHATSAPP_SERVICE_TOKEN="erp-whatsapp-local-token"
WHATSAPP_SERVICE_PORT=3010
WHATSAPP_SERVICE_HOST=127.0.0.1
WWEBJS_AUTH_PATH=storage/whatsapp-session
WWEBJS_CLIENT_ID=raptorerp-session

# WebPush Browser Push Notifications (VAPID keypair)
WEBPUSH_SUBJECT="mailto:admin@example.com"
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Socialite / Single Sign-On (SSO) OAuth Providers
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="http://localhost:8000/api/auth/facebook/callback"

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI="http://localhost:8000/api/auth/twitter/callback"

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI="http://localhost:8000/api/auth/instagram/callback"

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="http://localhost:8000/api/auth/linkedin/callback"

# ------------------------------------------------------------------------------
# External GST & E-Invoice Integration (Optional)
# ------------------------------------------------------------------------------
GST_API_BASE_URL=
GST_API_CLIENT_ID=
GST_API_CLIENT_SECRET=
GST_API_GSTIN=

# ------------------------------------------------------------------------------
# IMAP Inbound Email Ingestion (Optional)
# ------------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=

# ------------------------------------------------------------------------------
# AWS / Cloud Object Storage (S3) (Optional)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# Frontend / Vite Configuration
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
